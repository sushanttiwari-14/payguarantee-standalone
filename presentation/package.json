{
  "name": "presentation",
  "version": "1.0.0",
  "description": "Editable PayProof hackathon rehearsal",
  "repository": {},
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node --require ./scripts/loopback.cjs ./node_modules/@remotion/cli/remotion-cli.js studio --no-open --ipv4 --port 4324",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "captions": "node scripts/captions.mjs",
    "render": "remotion render PayProof-Demo out/payproof-demo.mp4 --codec=h264 --crf=18 --concurrency=1 --timeout=120000"
  },
  "overrides": {
    "@remotion/eslint-config-flat": {
      "typescript-eslint": "8.71.2"
    }
  }
